generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Semua nilai uang disimpan sebagai Int rupiah (tanpa desimal).

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())
}

model Category {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  sortOrder Int       @default(0)
  isVisible Boolean   @default(true)
  products  Product[]
}

model Product {
  id             String         @id @default(cuid())
  categoryId     String
  category       Category       @relation(fields: [categoryId], references: [id])
  name           String
  slug           String         @unique
  description    String         @default("")
  price          Int
  compareAtPrice Int?
  weightGrams    Int
  isVisible      Boolean        @default(true)
  isFeatured     Boolean        @default(false)
  createdAt      DateTime       @default(now())
  images         ProductImage[]
  variants       Variant[]

  @@index([categoryId])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  sortOrder Int     @default(0)

  @@index([productId])
}

model Variant {
  id         String      @id @default(cuid())
  productId  String
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  label      String
  sku        String      @unique
  /// Stok yang masih bisa dijual. Dikurangi saat pesanan dibuat (ditahan), dikembalikan saat batal/kedaluwarsa.
  stock      Int         @default(0)
  sortOrder  Int         @default(0)
  /// Varian yang dihapus dari form tetapi sudah pernah dipesan: disembunyikan, bukan dihapus.
  isArchived Boolean     @default(false)
  orderItems OrderItem[]

  @@index([productId])
}

enum OrderStatus {
  MENUNGGU_BAYAR
  MENUNGGU_VERIFIKASI
  DIBAYAR
  DIKEMAS
  DIKIRIM
  SELESAI
  BATAL
  KEDALUWARSA
  PERLU_TINDAKAN
}

enum PaymentMethod {
  MIDTRANS
  MANUAL
}

model Order {
  id                    String         @id @default(cuid())
  code                  String         @unique
  status                OrderStatus    @default(MENUNGGU_BAYAR)
  paymentMethod         PaymentMethod
  customerName          String
  phone                 String
  email                 String?
  /// Pembeli yang login dengan Google saat checkout. Kosong untuk checkout tanpa akun.
  customerId            String?
  customer              Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  provinceCode          String
  city                  String
  district              String
  /// Kelurahan/desa dari RajaOngkir. Kosong untuk pesanan mode tarif tetap.
  subdistrict           String?
  postalCode            String
  addressLine           String
  subtotal              Int
  shippingCost          Int
  /// Id tujuan RajaOngkir (dipakai menghitung ulang ongkir).
  shippingDestinationId String?
  /// Kode kurir (jne/jnt/sicepat) atau "standar" untuk tarif tetap provinsi.
  courierCode           String?
  courierService        String?
  shippingEtd           String?
  total                 Int
  weightGrams           Int
  paymentDeadline       DateTime
  /// true = stok item pesanan ini sedang dikurangi dari Variant. Dipakai agar stok tidak dikembalikan dua kali.
  stockHeld             Boolean        @default(true)
  trackingNumber        String?
  adminNote             String?
  rejectReason          String?
  refunded              Boolean        @default(false)
  midtransToken         String?
  midtransRedirectUrl   String?
  paidAt                DateTime?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  items                 OrderItem[]
  proofs                PaymentProof[]
  paymentEvents         PaymentEvent[]

  @@index([status])
  @@index([paidAt])
  @@index([customerId])
  /// Email selalu huruf kecil (dinormalkan saat checkout) untuk dicocokkan persis dengan email akun Google.
  @@index([email])
}

/// Pembeli yang login dengan Google. Hanya dipakai untuk riwayat pesanan; checkout tanpa akun tetap bisa.
model Customer {
  id        String   @id @default(cuid())
  /// `sub` dari Google: id akun yang tidak berubah walau email diganti.
  googleSub String   @unique
  /// Selalu huruf kecil, sudah diverifikasi Google.
  email     String   @unique
  name      String
  image     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    Order[]
}

model OrderItem {
  id           String  @id @default(cuid())
  orderId      String
  order        Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId    String
  variant      Variant @relation(fields: [variantId], references: [id])
  /// Salinan saat checkout agar laporan tidak berubah saat produk diedit.
  productName  String
  variantLabel String
  price        Int
  qty          Int
  weightGrams  Int

  @@index([orderId])
  @@index([variantId])
}

model PaymentProof {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  url       String
  createdAt DateTime @default(now())

  @@index([orderId])
}

/// Setiap notifikasi Midtrans yang diterima. Unique mencegah notifikasi ganda diproses dua kali.
model PaymentEvent {
  id         String   @id @default(cuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider   String
  externalId String
  status     String
  raw        Json
  createdAt  DateTime @default(now())

  @@unique([provider, externalId, status])
}

model ShippingRate {
  provinceCode String @id
  cost         Int
}

/// Cache respons API luar (RajaOngkir). Di database agar semua instance server berbagi cache yang sama.
model ApiCache {
  key       String   @id
  value     Json
  expiresAt DateTime

  @@index([expiresAt])
}

model Setting {
  key   String @id
  value Json
}
