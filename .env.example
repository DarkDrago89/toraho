# --- Database ---
# Lokal: docker compose up -d   ·   Produksi: connection string Neon
DATABASE_URL="postgresql://toraho:toraho@localhost:5434/toraho"
# Database khusus pengujian integrasi (jangan pakai database asli)
TEST_DATABASE_URL="postgresql://toraho:toraho@localhost:5434/toraho_test"

# --- Login admin ---
# Buat dengan: npx auth secret  (atau string acak 32+ karakter)
AUTH_SECRET="ganti-dengan-string-acak-panjang"
# Kata sandi akun admin@toraho.test yang dibuat oleh `npm run db:seed`
SEED_ADMIN_PASSWORD="toraho-demo-123"
# true = seed juga mengisi produk contoh (untuk deployment demo). Toko asli: false
SEED_DEMO_PRODUCTS="true"

# --- Midtrans ---
# Ambil dari dashboard Midtrans → Settings → Access Keys (sandbox dulu)
MIDTRANS_SERVER_KEY=""
MIDTRANS_IS_PRODUCTION="false"

# --- Penyimpanan foto & bukti transfer ---
# Kosongkan saat development: file disimpan di public/uploads
BLOB_READ_WRITE_TOKEN=""

# --- Lainnya ---
# Rahasia untuk endpoint cron /api/cron/expire
CRON_SECRET="ganti-dengan-string-acak"
# URL publik situs (link kembali dari Midtrans). Lokal: samakan port dengan server dev dan redirect URI Google (3001)
NEXT_PUBLIC_SITE_URL="http://localhost:3001"

# --- Login pembeli (Google) ---
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application).
# Authorized redirect URI: http://localhost:3001/api/auth/callback/google (+ domain demo/produksi).
# Kosongkan keduanya untuk mematikan login pembeli. Panduan: docs/google-login.md
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- Ongkir kurir (RajaOngkir / Komerce) ---
# Dashboard Komerce → Developer → Settings → API Key (layanan Shipping Cost). Kosongkan = tarif per provinsi.
# Setelah diisi, atur asal pengiriman di admin → Pengaturan → Ongkir Kurir. Panduan: docs/rajaongkir.md
RAJAONGKIR_API_KEY=""
# Kurir yang ditawarkan, sesuaikan dengan paket Komerce-mu (default jne:jnt:sicepat)
RAJAONGKIR_COURIERS="jne:jnt:sicepat"

# --- Midtrans: URL notifikasi saat uji lokal (opsional) ---
# Isi dengan URL tunnel, mis. https://xxxx.ngrok-free.app/api/midtrans/notification, agar webhook sampai ke laptop.
# Kosongkan di produksi (pakai URL di dashboard Midtrans). Panduan: docs/midtrans-sandbox.md
MIDTRANS_NOTIFICATION_URL=""
